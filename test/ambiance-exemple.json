{
  "id": "pop",
  "couleur": "#6d4fd6",
  "ajustee": false,
  "clair": {
    "--bg": "#eae9ff",
    "--surface": "#ffffff",
    "--surface-sunken": "#f4f3fe",
    "--border": "#deddf4",
    "--border-strong": "#c5c3ed",
    "--text": "#201b39",
    "--text-muted": "#615f81",
    "--accent": "#6d4fd6",
    "--accent-hover": "#583db3",
    "--accent-solid": "#6d4fd6",
    "--accent-solid-hover": "#5b3fb8",
    "--on-accent": "#ffffff",
    "--accent-ink": "#5f45bb",
    "--accent-soft": "#eeedff",
    "--accent-soft-border": "#d6d4ff",
    "--accent-2": "#f48044",
    "--accent-3": "#0eb09e",
    "--accent-end": "#b9267d",
    "--hard": "#c5c3ed"
  },
  "sombre": {
    "--bg": "#16132a",
    "--surface": "#221f39",
    "--surface-sunken": "#2b2846",
    "--border": "#3c375d",
    "--border-strong": "#534d81",
    "--text": "#eeedf9",
    "--text-muted": "#aaa8cd",
    "--accent": "#9681ff",
    "--accent-hover": "#a497ff",
    "--accent-solid": "#6d4fd6",
    "--accent-solid-hover": "#5b3fb8",
    "--on-accent": "#ffffff",
    "--accent-ink": "#a497ff",
    "--accent-soft": "#322c56",
    "--accent-soft-border": "#514885",
    "--accent-2": "#ff8f56",
    "--accent-3": "#36c3b1",
    "--accent-end": "#b9267d",
    "--hard": "#9681ff"
  },
  "forme": {
    "--radius-xs": "7px",
    "--radius-sm": "10px",
    "--radius-md": "14px",
    "--radius-lg": "18px",
    "--radius-pill": "999px",
    "--radius-btn": "999px",
    "--radius-input": "13px",
    "--radius-panel": "16px",
    "--gap": "8px",
    "--divider-w": "0px",
    "--ex-bg": "var(--bg)",
    "--main-overflow": "hidden",
    "--wash": "radial-gradient(420px 220px at 6% -4%, color-mix(in srgb, var(--accent-2) 24%, transparent), transparent 72%), radial-gradient(460px 240px at 100% 0%, color-mix(in srgb, var(--accent-solid) 22%, transparent), transparent 70%)",
    "--shadow-panel": "0 1px 2px color-mix(in srgb, var(--accent) 10%, transparent), 0 10px 24px -12px color-mix(in srgb, var(--accent) 45%, transparent)",
    "--shadow-ctl": "0 1px 2px color-mix(in srgb, var(--accent) 14%, transparent)",
    "--shadow-float": "0 24px 50px -14px color-mix(in srgb, var(--accent) 60%, transparent), 0 2px 10px rgba(30, 20, 80, .22)",
    "--stripe": "linear-gradient(90deg, var(--accent-solid), var(--accent-2), var(--accent-3))",
    "--stripe-h": "3px",
    "--font-ui": "ui-rounded, 'SF Pro Rounded', 'Hiragino Maru Gothic ProN', system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
    "--fw-head": "800",
    "--fs-head": "19px",
    "--ls-head": "-.01em",
    "--avatar-bg": "linear-gradient(135deg, var(--accent-solid), var(--accent-end))",
    "--avatar-fg": "var(--on-accent)",
    "--avatar-line": "transparent",
    "--fill": "linear-gradient(135deg, var(--accent-solid), var(--accent-end))",
    "--fill-hover": "linear-gradient(135deg, var(--accent-solid-hover), var(--accent-end))",
    "--fill-line": "transparent"
  }
}
